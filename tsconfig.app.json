{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Modo bundler: quem resolve import e transpila é o Vite, não o tsc. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Apelidos de caminho. Fonte única: o Vite lê daqui via resolve.tsconfigPaths.
       Sem "baseUrl" — o TypeScript 6 o marca como deprecado. */
    "paths": {
      "@core/*": ["./src/core/*"],
      "@ui/*": ["./src/ui/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@test/*": ["./src/test/*"]
    },

    /* Rigor. Tudo ligado de propósito: ver ARCHITECTURE.md, seção "TypeScript". */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
