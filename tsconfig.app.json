{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Modo bundler: quem resolve import e transpila e o Vite, nao o tsc. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Apelidos de caminho. Fonte unica: o Vite le daqui via vite-tsconfig-paths. */
    "paths": {
      "@nucleo/*": ["./src/nucleo/*"],
      "@interface/*": ["./src/interface/*"],
      "@idiomas/*": ["./src/idiomas/*"],
      "@testes/*": ["./src/testes/*"]
    },

    /* Rigor. Tudo ligado de proposito: ver ARQUITETURA.md, secao "TypeScript". */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
